{
  "name": "builtnorth/wp-mock-stand-ins",
  "description": "Minimal WordPress core class stand-ins for WP_Mock-based PHPUnit tests (WP_Error, WP_Query, WP_REST_Request, etc.) — no WordPress install required.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "BuiltNorth",
      "email": "hello@builtnorth.co"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "autoload-dev": {
    "files": [
      "inc/stand-ins.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "builtnorth/coding-standards": "^1.0"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev",
      "dev-dev": "1.0.x-dev"
    }
  }
}
